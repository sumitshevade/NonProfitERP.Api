@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView>
    <Authorized>
        <span style="top: 5px; right: 5px; z-index: 1040" class="position-absolute text-white">
            Hello, @context.User.FindFirst("FirstName").Value!
            <button type="button" @onclick="Logout" class="btn btn-primary">Log out</button>
        </span>

    </Authorized>
    <NotAuthorized>
        <a href="authentication/login">Log in</a>
    </NotAuthorized>
</AuthorizeView>
@*nav-link *@
@code
    {
    async Task Logout()
    {
        var localStateProvider = (LocalAuthenticationStateProvider)AuthenticationStateProvider;
        await localStateProvider.LogoutAsync();
        NavigationManager.NavigateTo("/authentication/login");
    }
}
