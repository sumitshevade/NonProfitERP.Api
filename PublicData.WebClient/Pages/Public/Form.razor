@inherits PersonComponent

<div class="row">
    <div class="col-md-7">
        <EditForm Model="Person" OnValidSubmit="@OnValidSubmit">
            <FluentValidationValidator />
            <div class="form-group" style="margin-top:50px">
                <label style="font-size:18.5px">Person Type</label>
                <PublicData.WebClient.Components.CustomInputSelect @bind-Value="Person.PersonTypeId" class="form-control">
                    <option value="0" selected>Select...</option>
                    @foreach (var item in PersonTypes)
                    {
                        <option value="@item.Id">@item.Value</option>
                    }
                </PublicData.WebClient.Components.CustomInputSelect>
                @*<ValidationMessage For="@(() => Person.PersonTypeId)" />*@
            </div>

            <div class="row" style="margin-top:25px">
                <div class="form-group col-md-4">
                    <label style="font-size:14pt">First Name </label>
                    <InputText @bind-Value="Person.FirstName" class="form-control" placeholder="First Name"></InputText>
                    <ValidationMessage For="@(() => Person.FirstName)" />
                </div>

                <div class="form-group col-md-4">
                    <label style="font-size:14pt">Middle Name</label>
                    <InputText @bind-Value="Person.MiddleName" class="form-control" placeholder="Middle Name"></InputText>
                    <ValidationMessage For="@(() => Person.MiddleName)" />
                </div>

                <div class="form-group col-md-4">
                    <label style="font-size:14pt">Last Name</label>
                    <InputText @bind-Value="Person.LastName" class="form-control" placeholder="Last Name"></InputText>
                    <ValidationMessage For="@(() => Person.LastName)" />
                </div>
            </div>

            <div class="form-group" style="margin-top:5px">
                <label style="font-size:14pt">Birth Date</label>
                <InputDate @bind-Value="Person.BirthDate" class="form-control" placeholder="Birth Date"></InputDate>
                <ValidationMessage For="@(() => Person.BirthDate)" />
            </div>

            <div class="form-group" style="margin-top:5px">
                <label style="font-size:14pt">Birth Location</label>
                <InputText @bind-Value="Person.BirthLocation" class="form-control" placeholder="Birth Location"></InputText>
                <ValidationMessage For="@(() => Person.BirthLocation)" />
            </div>

            <div class="form-group" style="margin-top:5px">
                <label style="font-size:14pt">Notes</label>
                <InputTextArea @bind-Value="Person.LongText" class="form-control" placeholder="Notes"></InputTextArea>
                <ValidationMessage For="@(() => Person.LongText)" />
            </div>

            <div class="form-group" style="margin-top:5px">
                <label style="font-size:14pt">Keywords</label>
                <InputTextArea @bind-Value="Person.Keywords" class="form-control" placeholder="Keywords"></InputTextArea>
                <ValidationMessage For="@(() => Person.Keywords)" />
            </div>

            <div class="form-group" style="margin-top:5px">
                <label style="font-size:14pt">Is Worker</label>
                <InputCheckbox @bind-Value="Person.IsWorker" class="form-control" placeholder="IsWorker"></InputCheckbox>
                <ValidationMessage For="@(() => Person.IsWorker)" />
            </div>

            <div class="form-group" style="margin-top:5px">
                <label style="font-size:14pt">Is Loginr</label>
                <InputCheckbox @bind-Value="Person.IsWorker" class="form-control" placeholder="IsWorker"></InputCheckbox>
                <ValidationMessage For="@(() => Person.IsWorker)" />
            </div>

            <div class="form-group" style="margin-top:50px">
                <label style="font-size:18.5px">Joined Type</label>
                <PublicData.WebClient.Components.CustomInputSelect @bind-Value="Person.JoinedAsId" class="form-control">
                    <option value="0" selected>Select...</option>
                    @foreach (var item in PersonTypes)
                    {
                        <option value="@item.Id">@item.Value</option>
                    }
                </PublicData.WebClient.Components.CustomInputSelect>
                @*<ValidationMessage For="@(() => Person.JoinedAsId)" />*@
            </div>

            <div class="form-group text-center" style="margin-top:30px">
                <button class="btn btn-primary form-control">
                    @ButtonText
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    [Parameter]
    public string ButtonText { get; set; } = "Save";

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }
}