                            <div class="tab-pane fade show active border m-3 p-4" id="pills-basic" role="tabpanel" aria-labelledby="pills-basic-tab">
                                <form action="dashboard.html" method="POST">
                                    <div class="row">
                                        <div class="col-sm-3">
                                            Shakha / Branch
                                            <select name="persontype" id="persontype" class="form-control" autofocus>
                                                <option value="0">Select...</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            Current Role
                                            <select name="persontype" id="persontype" class="form-control" autofocus>
                                                <option value="0">Select...</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            Is Worker
                                            <select name="isworker" id="isworker" class="form-control" required title="This will help while assigning roles in work.">
                                                <option value="0">Select...</option>
                                                <option value="2" selected>No</option>
                                                <option value="1">Yes</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-3">
                                            Work Frequency
                                            <select name="workfrequency" id="workfrequency" class="form-control" required>
                                                <option value="0">Select...</option>
                                                <option value="1">Daily</option>
                                                <option value="2">Weekly</option>
                                                <option value="3">Monthly</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-sm-3">
                                            First Name
                                            <input type="text" name="firstname" id="firstname" class="form-control" placeholder="First Name" required>
                                        </div>
                                        <div class="col-sm-3">
                                            Middle Name
                                            <input type="text" name="middlename" id="middlename" class="form-control" placeholder="Middle Name">
                                        </div>
                                        <div class="col-sm-3">
                                            Last Name
                                            <input type="text" name="lastname" id="lastname" class="form-control" placeholder="Last Name" required>
                                        </div>
                                        <div class="col-sm-3">
                                            Citizen Of
                                            <select name="nationality" id="nationality" class="form-control">
                                                <option value="0">Select...</option>
                                                <option value="1">India</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-sm-3">
                                            Birth Date
                                            <input type="date" name="birthdate" id="birthdate" class="form-control">
                                        </div>
                                        <div class="col-sm-3">
                                            Birth Location
                                            <input type="text" id="birthlocation" name="birthlocation" class="form-control" placeholder="Birth Location">
                                        </div>
                                        <div class="col-sm-3">
                                            Joining Date
                                            <input type="date" name="joiningdate" id="joiningdate" class="form-control">
                                        </div>
                                        <div class="col-sm-3">
                                            Joined As
                                            <select name="joinedas" id="joinedas" class="form-control" required>
                                                <option value="0">Select...</option>
                                                <option value="1">Wardhak</option>
                                                <option value="2">Teacher</option>
                                                <option value="3">Dhol Tasha</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="row mt-3">
                                        <div class="col-sm-3">
                                            Additional Information
                                            <textarea name="longtext" id="longtext" rows="3" class="form-control"></textarea>
                                        </div>
                                        <div class="col-sm-3">
                                            Keywords
                                            <textarea name="keywords" id="keywords" rows="3" class="form-control"></textarea>
                                        </div>
                                    </div>

                                    <div class="row mt-4">
                                        <div class="col-sm-3">
                                            <button class="btn btn-primary" type="submit">Save</button>
                                            <button class="btn btn-warning m-1" type="reset">Cancel</button>
                                        </div>
                                    </div>
                                </form>
                            </div>

                            <div class="tab-pane fade border m-3 p-4" id="pills-contact" role="tabpanel" aria-labelledby="pills-contact-tab">
                                <button type="button" class="btn btn-success" @onclick="AddContact">+ Add Contact</button>
                                <form action="person" method="POST" id="contactForm" class="@ContactFormDisplay">
                                    <div class="mt-1 border p-3">
                                        <div class="row">
                                            <div class="col-sm-3">
                                                Contact Type
                                                <select name="contacttype" id="contacttype" class="form-control" autofocus>
                                                    <option value="0">Select...</option>
                                                    <option value="1">Mobile No</option>
                                                    <option value="2">Email ID</option>
                                                </select>
                                            </div>
                                            <div class="col-sm-3">
                                                Value
                                                <input type="text" id="detail" name="detail" class="form-control">
                                            </div>
                                            <div class="col-sm-3">
                                                Is Default <br>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="isdefault" id="isdefault" value="Yes" checked>
                                                    <label class="form-check-label" for="inlineRadio1">Yes</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="isdefault" id="isdefault" value="No">
                                                    <label class="form-check-label" for="inlineRadio2">No</label>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="row mt-4">
                                            <div class="col-sm-3">
                                                <button id="saveContact" class="btn btn-primary" type="submit">Save</button>
                                                <button id="cancelContact" class="btn btn-warning m-1" type="reset">Cancel</button>
                                            </div>
                                        </div>
                                    </div>
                                </form>

