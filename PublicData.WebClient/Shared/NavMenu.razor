<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand text-white">PDMS</a>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <ul class="nav flex-column">

        <NavLink class="nav-link" href=""></NavLink>

        <AuthorizeView>
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                        <span class="oi oi-home" aria-hidden="true"></span> Home
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="()=> expandSubMenu = !expandSubMenu">
                        <span class="oi oi-people" aria-hidden="true"></span> Account
                    </NavLink>
                    @if (expandSubMenu)
                    {
                        <ul class="nav flex-column">
                            <li class="nav-item px-3">
                                <NavLink class="expand-menu" href="account/changepassword">
                                    <span class="oi oi-headphones" aria-hidden="true"></span> Change Password
                                </NavLink>
                            </li>
                        </ul>
                    }
                </li>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="people">
                        <span class="oi oi-plus" aria-hidden="true"></span> People
                    </NavLink>
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="schools">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> School
                    </NavLink>
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="persontypes">
                        <span class="oi oi-magnifying-glass" aria-hidden="true"></span> Person Type
                    </NavLink>
                </li>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="masters">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Other Masters
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="User">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="people">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Read People
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">
                        <span class="oi oi-briefcase" aria-hidden="true"></span> Reports
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
</div>

@code {
    private bool collapseNavMenu = true;

    private bool expandSubMenu;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
