@page "/account/changepassword"

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <h4 class="m-3 text-center">Change Password</h4>
            <div class="card-body">
                <h5 class="card-title">Please enter your details</h5>
                <EditForm Model="@ChangePass" OnValidSubmit="@NewChangePassword">
                    <FluentValidationValidator />
                    <ValidationSummary />

                    <div class="form-group">
                        <label for="@ChangePass.CurrentPassword">Current Password</label>
                        <InputText type="password" class="form-control" @bind-Value="@ChangePass.CurrentPassword" />
                        <ValidationMessage For="@(() => ChangePass.CurrentPassword)" />
                    </div>
                    <div class="form-group">
                        <label for="@ChangePass.NewPassword">New Password</label>
                        <InputText type="password" class="form-control" @bind-Value="ChangePass.NewPassword" />
                        <ValidationMessage For="@(() => ChangePass.NewPassword)" />
                    </div>
                    <div class="form-group">
                        <label for="@ChangePass.ConfirmPassword">Confirm Password</label>
                        <InputText Id="password" type="password" class="form-control" @bind-Value="ChangePass.ConfirmPassword" />
                        <ValidationMessage For="@(() => ChangePass.ConfirmPassword)" />
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </EditForm>
            </div>
        </div>
    </div>
</div>
@code{
    [Inject]
    public IAuthService AuthService { get; set; }

    [Inject]
    public NavigationManager NavigationManager { get; set; }

    [Inject]
    public IToastService ToastService { get; set; }

    private ChangePasswordModel ChangePass { get; set; } = new ChangePasswordModel();

    private async void NewChangePassword()
    {
        await AuthService.ChangePassword(ChangePass);
        ToastService.ShowSuccess("Password Changed Successfully");
        NavigationManager.NavigateTo("/home");
    }
}