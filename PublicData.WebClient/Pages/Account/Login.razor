@page "/authentication/login"
@inherits LoginComponent
@layout AuthLayout


@if (MessageType == AlertMessageType.Error)
{
    <div class="alert alert-danger" role="alert">
        <p>@Message</p>
    </div>
}
else if (IsBusy == true)
{
    <div class="text-center m-auto" style="padding: 150px 0px">
        <span class="spinner-grow"></span>
        Loading...
    </div>
}
else
{
    <div class="row mt-5 text-center">
        <div class="col-sm-12">
            <h3>'Swa'-roop wardhinee</h3>
            <h5>Data Management System</h5>
            <EditForm class="form-signin" Model="loginModel" OnValidSubmit="LoginUser">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <img class="mb-4" src="brand/bootstrap-solid.svg" alt="" width="72" height="72">
                <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>

                <label for="inputEmail" class="sr-only">Email address</label>
                <InputText type="email" id="email" class="form-control" @bind-Value="loginModel.Email" placeholder="Email address" required autofocus />
                <ValidationMessage For="@(() => loginModel.Email)" />

                <label for="inputPassword" class="sr-only">Password</label>
                <InputText type="password" id="password" class="form-control" @bind-Value="loginModel.Password" placeholder="Password" required />
                <ValidationMessage For="@(() => loginModel.Password)" />
                <div class="checkbox mb-3">
                    <label>
                        <input type="checkbox" value="remember-me"> Remember me
                    </label>
                </div>
                <button class="btn btn-lg btn-primary btn-block" type="submit">Sign in</button>
                <p class="mt-5 mb-3 text-muted">&copy; 2020</p>
            </EditForm>
        </div>
    </div>
}
