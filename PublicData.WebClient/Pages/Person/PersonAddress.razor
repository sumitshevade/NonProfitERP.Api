@inherits PersonComponent

<div class="tab-pane fade border m-3 p-4" id="pills-address" role="tabpanel" aria-labelledby="pills-address-tab">
    <button type="button" class="btn btn-success" @onclick="AddAddress">+ Add Address</button>

    <EditForm Model="PersonAddress" OnValidSubmit="CreateAddress">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="mt-1 border p-3 @FormDisplay">
            <div class="row">
                <div class="col-sm-3">
                    Country
                    <InputSelect ValueChanged="@((string value) => ChangeCountryForStates(value))"
                                 ValueExpression="@(() => SelectedCountryId)"
                                 Value="@SelectedCountryId"
                                 class="form-control" required>
                        <option selected>Select...</option>
                        @foreach (var item in Countries)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    State
                    <InputSelect ValueChanged="@((string value) => ChangeStateForCitiesDistricts(value))"
                                 ValueExpression="@(() => SelectedStateId)"
                                 Value="@SelectedStateId"
                                 class="form-control" required>
                        @*<option selected>Select...</option>*@
                        @foreach (var item in States)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    City
                    <InputSelect ValueChanged="@((string value) => ChangeCity(value))"
                                 ValueExpression="@(() => SelectedCityId)"
                                 Value="@SelectedCityId"
                                 class="form-control" required>
                        @*<option selected>Select...</option>*@
                        @foreach (var item in Cities)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    District
                    <InputSelect ValueChanged="@((string value) => ChangeDistrictForTaluka(value))"
                                 ValueExpression="@(() => SelectedDistrictId)"
                                 Value="@SelectedDistrictId"
                                 class="form-control">
                        <option value="0" selected>Select...</option>
                        @foreach (var item in Districts)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Taluka
                    <InputSelect ValueChanged="@((string value) => ChangeTaluka(value))"
                                 ValueExpression="@(() => SelectedTalukaId)"
                                 Value="@SelectedTalukaId"
                                 class="form-control">
                        <option value="0" selected>Select...</option>
                        @foreach (var item in Talukas)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Village Name
                    <InputText @bind-Value="PersonAddress.Village" class="form-control"></InputText>
                </div>
                <div class="col-sm-3">
                    Is Permanent
                    <InputSelect ValueChanged="@((string value) => ChangeIsPermanentAddress(value))"
                                 ValueExpression="@(() => SelectedIsPermanentAddress)"
                                 Value="@SelectedIsPermanentAddress"
                                 class="form-control" required>
                        @*<option selected>Select...</option>*@
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Road Name
                    <InputText @bind-Value="PersonAddress.RoadName" class="form-control"></InputText>
                </div>
                <div class="col-sm-3">
                    Line 1
                    <InputTextArea @bind-Value="PersonAddress.Line1" rows="3" class="form-control"></InputTextArea>
                </div>
                <div class="col-sm-3">
                    Line 2
                    <InputTextArea @bind-Value="PersonAddress.Line2" rows="3" class="form-control"></InputTextArea>
                </div>
                <div class="col-sm-3">
                    Zip Code
                    <InputText @bind-Value="PersonAddress.ZipCode" required class="form-control"></InputText>
                </div>
                <div class="col-sm-3">
                    From Year
                    <InputNumber @bind-Value="PersonAddress.FromYear" required class="form-control"></InputNumber>
                </div>
                <div class="col-sm-3">
                    To Year
                    <InputNumber @bind-Value="PersonAddress.ToYear" required class="form-control"></InputNumber>
                </div>
                <div class="col-sm-3">
                    Rooms in Home
                    <InputNumber @bind-Value="PersonAddress.RoomsInHome" required class="form-control"></InputNumber>
                </div>
                <div class="col-sm-3">
                    Is Govt Built Up
                    <InputSelect ValueChanged="@((string value) => ChangeIsGovtBuiltUp(value))"
                                 ValueExpression="@(() => SelectedIsGovtBuiltUp)"
                                 Value="@SelectedIsGovtBuiltUp"
                                 class="form-control">
                        <option selected value="0">Select...</option>
                        <option value="true">Yes</option>
                        <option value="false">No</option>
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Home Status
                    <InputSelect ValueChanged="@((string value) => ChangeHomeStatus(value))"
                                 ValueExpression="@(() => SelectedHomeStatusId)"
                                 Value="@SelectedHomeStatusId"
                                 class="form-control">
                        <option value="0" selected>Select...</option>
                        @foreach (var item in HomeStatus)
                        {
                            <option value="@item.Id">@item.Value</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Locality Class
                    <InputSelect ValueChanged="@((string value) => ChangeLocalityStatus(value))"
                                 ValueExpression="@(() => SelectedLocalityClassId)"
                                 Value="@SelectedLocalityClassId"
                                 class="form-control">
                        <option value="0" selected>Select...</option>
                        @foreach (var item in LocalityClass)
                        {
                            <option value="@item.Id">@item.Value</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Residential Status
                    <InputSelect ValueChanged="@((string value) => ChangeResidentialStatus(value))"
                                 ValueExpression="@(() => SelectedResidentialStatusId)"
                                 Value="@SelectedResidentialStatusId"
                                 class="form-control">
                        <option value="0" selected>Select...</option>
                        @foreach (var item in ResidentialStatus)
                        {
                            <option value="@item.Id">@item.Value</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-sm-3">
                    Residential Area
                    <InputSelect ValueChanged="@((string value) => ChangeResidentialArea(value))"
                                 ValueExpression="@(() => SelectedResidentialAreaId)"
                                 Value="@SelectedResidentialAreaId"
                                 class="form-control">
                        <option value="0" selected>Select...</option>
                        @foreach (var item in ResidentialAreas)
                        {
                            <option value="@item.Id">@item.Value</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-sm-3">
                    <button class="btn btn-primary" type="submit">@AddressSaveButton</button>
                    <button class="btn btn-warning m-1" type="reset" @onclick="(() => CancelAddress())">Cancel</button>
                </div>
            </div>
        </div>
    </EditForm>

    <table class="table table-hover mt-5">
        <thead>
            <tr>
                <th scope="col">City</th>
                <th scope="col">From Year</th>
                <th scope="col">To Year</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in PersonAddresses)
            {
                <tr>
                    <td>@item.CityId</td>
                    <td>@item.FromYear</td>
                    <td>@item.ToYear</td>
                    <td>
                        <a class="btn btn-success text-white btn-sm" @onclick="(() => EditAddress(item.Id))">Edit</a>
                        <a class="btn btn-danger text-white btn-sm" @onclick="(() => DeleteAddress(item.Id))">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {

    private void AddAddress()
    {
        FormDisplay = CommonService.ToggleClass(FormDisplay, "d-none");
    }
}
