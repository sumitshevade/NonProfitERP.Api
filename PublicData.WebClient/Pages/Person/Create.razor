@page "/person/create"
@inherits PersonComponent

@if (MessageType == AlertMessageType.Error)
{
    <div class="alert alert-danger" role="alert">
        <p>@Message</p>
    </div>
}

@if (CommonService.IsBusy == true)
{
    <div class="text-center m-auto" style="padding: 150px 0px">
        <span class="spinner-border"></span>
        <br />
        Loading...
        @* TODO: Add random text here like fun facts *@
    </div>
}
else
{
    <div class="row">
        <div class="col-sm-12">
            <div class="card-deck mb-3 text-left">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header">
                        @*TODO: Remove this save all button *@
                        <h4 class="my-0 font-weight-normal">Create Person <span class="float-right">
                                <button type="reset" class="btn btn-success text-white" @onclick="RemovePersonId">Save All</button></span>
                        </h4>
                    </div>

                    <div class="card-body">
                        <ul class="nav nav-tabs">
                            <li class="nav-item">
                                <a class="nav-link active" id="pills-basic-tab" data-toggle="pill" href="#pills-basic"
                                   role="tab" aria-controls="pills-home" aria-selected="true">Basic</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="pills-contact-tab" data-toggle="pill" href="#pills-contact"
                                    role="tab" aria-controls="pills-contact" aria-selected="false">Contact</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" id="pills-address-tab" data-toggle="pill" href="#pills-address"
                                   role="tab" aria-controls="pills-address" aria-selected="false">Address</a>
                            </li>
                            @*<li class="nav-item">
                                    <a class="nav-link" id="pills-education-tab" data-toggle="pill" href="#pills-education"
                                        role="tab" aria-controls="pills-education" aria-selected="false">Education</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-work-tab" data-toggle="pill" href="#pills-work"
                                        role="tab" aria-controls="pills-work" aria-selected="false">Work Exp</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-family-tab" data-toggle="pill" href="#pills-family"
                                        role="tab" aria-controls="pills-family" aria-selected="false">Family Details</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-disability-tab" data-toggle="pill" href="#pills-disability"
                                        role="tab" aria-controls="pills-disability" aria-selected="false">Disabilities</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-health-tab" data-toggle="pill" href="#pills-health"
                                        role="tab" aria-controls="pills-health" aria-selected="false">Health Details</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-achievement-tab" data-toggle="pill" href="#pills-achievement"
                                        role="tab" aria-controls="pills-achievement" aria-selected="false">Achivement</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-sm-tab" data-toggle="pill" href="#pills-sm"
                                        role="tab" aria-controls="pills-sm" aria-selected="false">Social Media</a>
                                </li>*@
                            <li class="nav-item">
                                <a class="nav-link" id="pills-private-tab" data-toggle="pill" href="#pills-private"
                                   role="tab" aria-controls="pills-private" aria-selected="false">Private</a>
                            </li>
                            @*<li class="nav-item">
                                    <a class="nav-link" id="pills-language-tab" data-toggle="pill" href="#pills-language"
                                       role="tab" aria-controls="pills-language" aria-selected="false">Language</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" id="pills-hobby-tab" data-toggle="pill" href="#pills-hobby"
                                       role="tab" aria-controls="pills-hobby" aria-selected="false">Hobby</a>
                                </li>*@
                        </ul>

                        // TODO
                        ** If user logged in, don't show the shakha name
                        ** If others logged in, show the shakha name
                        <div class="tab-content" id="pills-tabContent">
                            <PersonBasic></PersonBasic>

                            <PersonContact></PersonContact>

                            <PersonAddress></PersonAddress>

                            <PersonEducation></PersonEducation>

                            <PersonWorkExperience></PersonWorkExperience>

                            <PersonFamilyMember></PersonFamilyMember>

                            <PersnoDisability></PersnoDisability>

                            <PersonHealthInfo></PersonHealthInfo>

                            <PersonAchievement></PersonAchievement>

                            <PersonSocialMedia></PersonSocialMedia>

                            <PersonPrivateInfo></PersonPrivateInfo>

                            <PersonLanguage></PersonLanguage>

                            <PersonHobby></PersonHobby>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
