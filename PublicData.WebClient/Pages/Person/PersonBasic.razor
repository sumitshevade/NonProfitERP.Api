@inherits PersonComponent

<div class="tab-pane fade show active border m-3 p-4" id="pills-basic" role="tabpanel" aria-labelledby="pills-basic-tab">
    <EditForm Model="Person" OnValidSubmit="CreatePerson">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div class="col-sm-3">
                Current Role
                <InputSelect ValueChanged="@((string value) => ChangePersonType(value))"
                             ValueExpression="@(() => SelectedPersonTypeId)"
                             Value="@SelectedPersonTypeId"
                             class="form-control" required>
                    <option value="0">Select...</option>
                    @foreach (var item in PersonTypes)
                    {
                        <option value="@item.Id">@item.Value</option>
                    }
                </InputSelect>
            </div>
            <div class="col-sm-3">
                Is Worker
                <InputSelect ValueChanged="@((string value) => ChangeIsWorker(value))"
                             ValueExpression="@(() => SelectedIsWorker)"
                             Value="@SelectedIsWorker"
                             class="form-control" required title="This will help while assigning roles in work.">
                    <option disabled>Select...</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </InputSelect>
            </div>
            <div class="col-sm-3">
                Work Frequency
                <InputSelect ValueChanged="@((string value) => ChangeWorkFrequency(value))"
                             ValueExpression="@(() => SelectedWorkFrequencyId)"
                             Value="@SelectedWorkFrequencyId"
                             class="form-control" required>
                    <option value="0">Select...</option>
                    @foreach (var item in WorkFrequencies)
                    {
                        <option value="@item.Id">@item.Value</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-3">
                First Name
                <InputText @bind-Value="Person.FirstName" class="form-control" placeholder="First Name" required></InputText>
                <ValidationMessage For="@(() => Person.FirstName)" />
            </div>
            <div class="col-sm-3">
                Middle Name
                <InputText @bind-Value="Person.MiddleName" class="form-control" placeholder="Middle Name"></InputText>
            </div>
            <div class="col-sm-3">
                Last Name
                <InputText @bind-Value="Person.LastName" class="form-control" placeholder="Last Name" required></InputText>
            </div>
            <div class="col-sm-3">
                Citizen Of
                <InputSelect ValueChanged="@((string value) => ChangeCountry(value))"
                             ValueExpression="@(() => SelectedCoutryId)"
                             Value="@SelectedCoutryId"
                             class="form-control" required>
                    <option value="0">Select...</option>
                    @foreach (var item in Countries)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-3">
                Birth Date
                <InputDate @bind-Value="Person.BirthDate" class="form-control"></InputDate>
            </div>
            <div class="col-sm-3">
                Birth Location
                <InputText @bind-Value="Person.BirthLocation" class="form-control" placeholder="Birth Location"></InputText>
            </div>
            <div class="col-sm-3">
                Joining Date
                <InputDate @bind-Value="Person.JoiningDate" class="form-control"></InputDate>
            </div>
            <div class="col-sm-3">
                Joined As
                <InputSelect ValueChanged="@((string value) => ChangeJoinedAs(value))"
                             ValueExpression="@(() => SelectedJoinedAsId)"
                             Value="@SelectedJoinedAsId"
                             class="form-control" required>
                    <option value="0">Select...</option>
                    @foreach (var item in JoinedAs)
                    {
                        <option value="@item.Id">@item.Value</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-sm-3">
                Additional Information
                <InputTextArea @bind-Value="Person.LongText" rows="3" class="form-control"></InputTextArea>
            </div>
            <div class="col-sm-3">
                Keywords
                <InputTextArea @bind-Value="Person.Keywords" rows="3" class="form-control"></InputTextArea>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-sm-3">
                <button class="btn btn-primary" type="submit">Save</button>
                <button class="btn btn-warning m-1" @onclick="CancelPerson" type="reset">Cancel</button>
            </div>
        </div>
    </EditForm>
</div>
